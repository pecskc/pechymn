    {
      "id": "hymn_b_18",
      "collection": "hymn_b",
      "hymnAbbr": "敬",
      "number": "018",
      "fields": [
        { "key": "titleOriginal", "label": "原文歌名", "value": "I Will Sing of the Mercies of the Lord", "sourceUrl": "https://hymnary.org/text/i_will_sing_of_the_mercies_of_the_lord_f", "sourceLabel": "hymnary.org" },
        { "key": "lyricist", "label": "作詞", "value": "James H. Fillmore", "sourceUrl": "https://hymnary.org/text/i_will_sing_of_the_mercies_of_the_lord_f", "sourceLabel": "hymnary.org" },
        { "key": "composer", "label": "作曲", "value": "James H. Fillmore（曲調：FILLMORE／Fillmore 12333）", "sourceUrl": "https://hymnary.org/text/i_will_sing_of_the_mercies_of_the_lord_f", "sourceLabel": "hymnary.org" },
        { "key": "year", "label": "原作年份", "value": "1897", "sourceUrl": "https://www.hymnallibrary.org/hymns/i-will-sing-of-the-mercies-of-the-lord/", "sourceLabel": "hymnallibrary.org" },
        { "key": "themes", "label": "主題標籤", "value": "神的慈愛、信實、讚美、世代傳揚" },
        { "key": "background", "label": "背景故事摘要", "value": "由美國福音詩歌作曲家 James H. Fillmore 於十九世紀後期創作，歌詞幾乎直接取自《詩篇 89:1》，表達信徒要不斷傳唱神的慈愛，並向世世代代見證祂的信實。Fillmore 致力創作簡單易學、適合會眾齊唱的詩歌，因此此曲採用重複而明快的旋律及簡潔歌詞，讓不同年齡的信徒都能輕易學習和記憶。詩歌因具濃厚聖經基礎及喜樂敬拜氣氛，廣泛流傳於主日學、福音聚會及教會崇拜中。全詩強調讚美神不僅是歌唱的行動，更是信心、感恩與見證的表達，鼓勵信徒無論順境逆境，都要述說神永不改變的慈愛與信實，堅信祂的憐憫存到永遠。", "sourceUrl": "https://www.hymnallibrary.org/hymns/i-will-sing-of-the-mercies-of-the-lord/", "sourceLabel": "hymnallibrary.org" },
        { "key": "scripture", "label": "相關經文", "value": "詩篇 89:1", "sourceUrl": "https://www.hymnallibrary.org/hymns/i-will-sing-of-the-mercies-of-the-lord/", "sourceLabel": "hymnallibrary.org" }
      ],
      "allSources": ["https://hymnary.org/text/i_will_sing_of_the_mercies_of_the_lord_f", "https://www.hymnallibrary.org/hymns/i-will-sing-of-the-mercies-of-the-lord/"]
    },
