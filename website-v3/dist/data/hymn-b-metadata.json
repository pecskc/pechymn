        { "key": "lyricist", "label": "作詞", "value": "Martin Rinkart", "sourceUrl": "https://hymnary.org/text/now_thank_we_all_our_god", "sourceLabel": "hymnary.org" },
        { "key": "composer", "label": "作曲", "value": "Johann Cruger（曲調：NUN DANKET）", "sourceUrl": "https://hymnary.org/text/now_thank_we_all_our_god", "sourceLabel": "hymnary.org" },
        { "key": "year", "label": "原作年份", "value": "1636", "sourceUrl": "https://en.wikipedia.org/wiki/Now_Thank_We_All_Our_God", "sourceLabel": "en.wikipedia.org" },
        { "key": "themes", "label": "主題標籤", "value": "感恩、神的恩典、三一敬拜" },
        { "key": "background", "label": "背景故事摘要", "value": "由德國路德宗牧師 Martin Rinkart 於三十年戰爭（1618-1648）期間創作，被譽為德國的「國民感恩頌」。Rinkart 身處戰亂、瘟疫與饑荒肆虐的 Eilenburg，曾在 1637 年瘟疫期間成為城中唯一倖存牧師，每日主持數十場葬禮，仍持續服事難民與貧苦百姓。他不僅以信仰鼓勵會眾，更曾帶領民眾禱告，成功促使駐軍減輕苛重稅賦。此詩後由 Catherine Winkworth 譯成英文，並配上 Johann Crüger 所譜寫的莊嚴旋律而廣為流傳。全詩共三節：首先感謝神豐盛恩典，其次祈求神引導與保守，最後頌讚聖父、聖子、聖靈三一真神。雖誕生於苦難歲月，詩歌卻見證神在逆境中的恩典，傳達堅定感恩與盼望的信息。", "sourceUrl": "https://www.hymnallibrary.org/hymns/now-thank-we-all-our-god/", "sourceLabel": "hymnallibrary.org" },
        { "key": "scripture", "label": "相關經文", "value": "詩篇 147 篇；羅馬書 8:35, 37", "sourceUrl": "https://www.hymnallibrary.org/hymns/now-thank-we-all-our-god/", "sourceLabel": "hymnallibrary.org" }
      ],
      "allSources": ["https://hymnary.org/text/now_thank_we_all_our_god", "https://en.wikipedia.org/wiki/Now_Thank_We_All_Our_God", "https://www.hymnallibrary.org/hymns/now-thank-we-all-our-god/"]
    },
