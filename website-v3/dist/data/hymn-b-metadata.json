        { "key": "titleOriginal", "label": "原文歌名", "value": "Come Thou Almighty King", "sourceUrl": "https://hymnary.org/text/come_thou_almighty_king_help_us_thy", "sourceLabel": "hymnary.org" },
        { "key": "lyricist", "label": "作詞", "value": "Anonymous", "sourceUrl": "https://hymnary.org/text/come_thou_almighty_king_help_us_thy", "sourceLabel": "hymnary.org" },
        { "key": "composer", "label": "作曲", "value": "Felice Giardini（曲調：ITALIAN HYMN）", "sourceUrl": "https://hymnary.org/text/come_thou_almighty_king_help_us_thy", "sourceLabel": "hymnary.org" },
        { "key": "year", "label": "原作年份", "value": "1757", "sourceUrl": "https://hymnary.org/text/come_thou_almighty_king_help_us_thy", "sourceLabel": "hymnary.org" },
        { "key": "themes", "label": "主題標籤", "value": "三一敬拜、頌讚、聖靈祈求" },
        { "key": "background", "label": "背景故事摘要", "value": "《Come Thou Almighty King》是一首廣受歡迎的三一頌聖詩，但其作者至今未能確定。十九世紀部分聖詩學者曾將其歸於 Charles Wesley 名下，但現代大多數聖詩集均標示為佚名作品。此詩最早於1757年刊載於 George Whitefield 編輯的《Collection of Hymns for Social Worship》增刊中，原題為「An Hymn to the Trinity」，內容向聖父、聖子及聖靈獻上敬拜與祈求，頌讚三一神的權能、恩典與統治。詩歌最初按當時英國皇家頌歌的旋律演唱，其後由義大利作曲家 Felice Giardini 應 Selina Shirley 伯爵夫人邀請，為此詩譜寫著名曲調〈Italian Hymn〉（又稱〈Moscow〉或〈Trinity〉），並於1769年出版。", "sourceUrl": "https://en.wikipedia.org/wiki/Come_Thou_Almighty_King", "sourceLabel": "en.wikipedia.org" },
        { "key": "scripture", "label": "相關經文", "value": "詩篇 24:10", "sourceUrl": "https://en.wikipedia.org/wiki/Come_Thou_Almighty_King", "sourceLabel": "en.wikipedia.org" }
      ],
      "allSources": ["https://hymnary.org/text/come_thou_almighty_king_help_us_thy", "https://en.wikipedia.org/wiki/Come_Thou_Almighty_King"]
    },
