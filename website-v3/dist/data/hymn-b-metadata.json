        { "key": "titleOriginal", "label": "原文歌名", "value": "O Worship the King", "sourceUrl": "https://www.hymnallibrary.org/hymns/o-worship-the-king/", "sourceLabel": "hymnallibrary.org" },
        { "key": "lyricist", "label": "作詞", "value": "Robert Grant", "sourceUrl": "https://hymnary.org/text/o_worship_the_king_all_glorious_above", "sourceLabel": "hymnary.org" },
        { "key": "themes", "label": "主題標籤", "value": "敬拜、上帝大能、創造" },
        { "key": "background", "label": "背景故事摘要", "value": "由英國詩人兼政治家 Robert Grant 於1833年創作，靈感源自《詩篇 104》，被譽為十九世紀最優秀的敬拜聖詩之一。詩歌以豐富而莊嚴的意象描繪神的榮耀、權能、慈愛與看顧，稱頌祂是永恆的君王、保護者和創造主，帶領信徒以敬畏與感恩的心敬拜神。Grant 雖身居公職，後來出任印度孟買總督，仍熱心推動基督教信仰與宣教事工。此詩最常配上〈Lyons〉曲調，其雄偉莊重的旋律與歌詞相得益彰，使詩歌廣受各地教會喜愛。全詩不僅讚美神在創造與護理中的偉大作為，也提醒信徒敬拜乃是對神至高價值與救贖恩典的回應。", "sourceUrl": "https://www.hymnallibrary.org/hymns/o-worship-the-king/", "sourceLabel": "hymnallibrary.org" },
        { "key": "scripture", "label": "相關經文", "value": "詩篇 104", "sourceUrl": "https://www.hymnallibrary.org/hymns/o-worship-the-king/", "sourceLabel": "hymnallibrary.org" }
      ],
      "allSources": ["https://hymnary.org/text/o_worship_the_king_all_glorious_above", "https://www.hymnallibrary.org/hymns/o-worship-the-king/"]
    },
