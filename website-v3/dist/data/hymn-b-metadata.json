        { "key": "titleOriginal", "label": "原文歌名", "value": "A Mighty Fortress Is Our God", "sourceUrl": "https://en.wikipedia.org/wiki/A_Mighty_Fortress_Is_Our_God", "sourceLabel": "en.wikipedia.org" },
        { "key": "lyricist", "label": "作詞", "value": "Martin Luther", "sourceUrl": "https://en.wikipedia.org/wiki/A_Mighty_Fortress_Is_Our_God", "sourceLabel": "en.wikipedia.org" },
        { "key": "composer", "label": "作曲", "value": "Martin Luther（曲調：EIN FESTE BURG）", "sourceUrl": "https://en.wikipedia.org/wiki/A_Mighty_Fortress_Is_Our_God", "sourceLabel": "en.wikipedia.org" },
        { "key": "year", "label": "原作年份", "value": "約 1529 年", "sourceUrl": "https://en.wikipedia.org/wiki/A_Mighty_Fortress_Is_Our_God", "sourceLabel": "en.wikipedia.org" },
        { "key": "themes", "label": "主題標籤", "value": "倚靠上帝、屬靈爭戰、基督得勝" },
        { "key": "background", "label": "背景故事摘要", "value": "由宗教改革領袖 Martin Luther 於1527至1529年間創作，歌詞與曲調皆出自其手筆，被譽為「宗教改革的戰歌」。詩歌主要根據《詩篇 46》寫成，宣告神是信徒的避難所、力量和患難中隨時的幫助。創作期間正值宗教改革風暴、黑死病肆虐及個人喪女之痛，Martin Luther 同時面對來自羅馬天主教會和神聖羅馬帝國的威脅，卻仍以堅定信心見證神的保守與得勝。關於其創作背景有多種說法，包括與 Worms 議會、Speyer 議會、Augsburg 議會，以及紀念殉道者 Leonhard Kaiser 等事件有關，但皆反映改革運動面臨的激烈挑戰。此詩很快收錄於早期路德宗聖詩集，後被翻譯成多種語言，成為歷世歷代信徒在逆境中倚靠神、勇敢持守信仰的重要詩歌。", "sourceUrl": "https://en.wikipedia.org/wiki/A_Mighty_Fortress_Is_Our_God", "sourceLabel": "en.wikipedia.org" },
        { "key": "scripture", "label": "相關經文", "value": "詩篇 46", "sourceUrl": "https://www.hymnallibrary.org/hymns/a-mighty-fortress-is-our-god/", "sourceLabel": "hymnallibrary.org" }
      ],
      "allSources": ["https://en.wikipedia.org/wiki/A_Mighty_Fortress_Is_Our_God", "https://www.hymnallibrary.org/hymns/a-mighty-fortress-is-our-god/"]
    },
