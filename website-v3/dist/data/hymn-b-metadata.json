        { "key": "titleOriginal", "label": "原文歌名", "value": "Come, We That Love the Lord（常用副題：We're Marching to Zion）", "sourceUrl": "https://hymnary.org/text/come_we_that_love_the_lord_and_let_our", "sourceLabel": "hymnary.org" },
        { "key": "lyricist", "label": "作詞", "value": "Isaac Watts", "sourceUrl": "https://hymnary.org/text/come_we_that_love_the_lord_and_let_our", "sourceLabel": "hymnary.org" },
        { "key": "composer", "label": "作曲", "value": "Robert Lowry（曲調：MARCHING TO ZION）", "sourceUrl": "https://hymnary.org/text/come_we_that_love_the_lord_and_let_our", "sourceLabel": "hymnary.org" },
        { "key": "year", "label": "原作年份", "value": "1707", "sourceUrl": "https://hymnary.org/text/come_we_that_love_the_lord_and_let_our", "sourceLabel": "hymnary.org" },
        { "key": "themes", "label": "主題標籤", "value": "天國盼望、聖徒團契、喜樂讚美、錫安" },
        { "key": "background", "label": "背景故事摘要", "value": "由被譽為「英語聖詩之父」的 Isaac Watts 創作，最早收錄於 1707 年《Hymns & Sacred Songs》，原題為「Heavenly Joy on Earth」。詩歌邀請愛主的人同心敬拜、歡喜歌唱，一同奔向天上的錫安，強調信徒在天路歷程中的合一、團契與盼望。歌詞以簡潔優美的文字和豐富的聖經意象，表達對天堂應許的嚮往，以及現今彼此扶持的喜樂。此詩採用 8.6.8.6 格律，後來配上〈St. Thomas〉及 Robert Lowry 的《Marching to Zion》等曲調而廣泛流傳，成為教會巡行及復興聚會中的經典詩歌。雖然歷經 John Wesley 等人多次修訂與刪改，衍生眾多版本，但原作仍被視為 Isaac Watts 聖詩創作才能的代表作之一，持續激勵信徒以歡欣和信心同行天路。", "sourceUrl": "https://www.hymnallibrary.org/hymns/were-marching-to-zion/", "sourceLabel": "hymnallibrary.org" }
      ],
      "allSources": ["https://hymnary.org/text/come_we_that_love_the_lord_and_let_our", "https://www.hymnallibrary.org/hymns/were-marching-to-zion/"]
    },
