        { "key": "titleOriginal", "label": "原文歌名", "value": "O Day of Rest and Gladness", "sourceUrl": "https://hymnary.org/text/o_day_of_rest_and_gladness", "sourceLabel": "hymnary.org" },
        { "key": "lyricist", "label": "作詞", "value": "Christopher Wordsworth", "sourceUrl": "https://hymnary.org/text/o_day_of_rest_and_gladness", "sourceLabel": "hymnary.org" },
        { "key": "composer", "label": "作曲", "value": "Lowell Mason（曲調：MENDEBRAS）", "sourceUrl": "https://hymnary.org/text/o_day_of_rest_and_gladness", "sourceLabel": "hymnary.org" },
        { "key": "year", "label": "原作年份", "value": "1862", "sourceUrl": "https://hymnary.org/text/o_day_of_rest_and_gladness", "sourceLabel": "hymnary.org" },
        { "key": "themes", "label": "主題標籤", "value": "主日敬拜、安息、復活、三一頌讚" },
        { "key": "background", "label": "背景故事摘要", "value": "由英國聖公會主教兼學者 Christopher Wordsworth 於1862年創作，是一首歌頌主日的經典聖詩。詩歌以豐富的聖經意象，讚美主日不僅是停止勞碌的安息日，更是敬拜神、靈命更新和與主相交的寶貴時刻。歌詞回顧神創造後的安息、西奈山頒布律法、基督復活及聖靈降臨等重要救贖事件，突顯主日在救恩歷史中的屬靈意義。詩中亦描繪信徒於主日聚集敬拜、領受神話語、同聲頌讚的喜樂，並將主日視為將來天上永恆安息與榮耀的預表。Christopher Wordsworth 以深厚的神學根基和優雅詩筆聞名，此詩被視為其代表作之一，常配以〈Ellacombe〉或〈Mendebras〉等曲調演唱。", "sourceUrl": "https://www.hymnallibrary.org/hymns/o-day-of-rest-and-gladness/", "sourceLabel": "hymnallibrary.org" }
      ],
      "allSources": ["https://hymnary.org/text/o_day_of_rest_and_gladness", "https://www.hymnallibrary.org/hymns/o-day-of-rest-and-gladness/"]
    },
